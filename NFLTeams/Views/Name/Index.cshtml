@model TeamsViewModel
@{
    ViewData["Title"] = "Change User Name";
}

<div class="text-center">
    <h2>Change user name</h2>
    <form asp-action="Change" method="post">
        <input asp-for="username" placeholder="Type name here" class="mb-3" /><br />
        <!--you can code a link to the Home page here --> <button type="submit" class="btn btn-primary">
            Change Name
        </button>
        <a asp-action="Index" asp-controller="Home" class="btn btn-primary" asp-route-activeConf="@Model.ActiveConf" asp-route-activeDiv="@Model.ActiveDiv">
            Back to Home Page
        </a>
    </form>
    <br />
</div>